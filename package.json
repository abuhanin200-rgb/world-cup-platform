    "purge:notifications": "node --env-file=.env.local scripts/purge-notifications.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.0.0",
    "framer-motion": "^12.42.2",
