{
  "name": "world-cup-2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:predictions": "node --test tests/predictions/*.test.mjs",
